# Copy this file to ".env" and replace the values. The real .env is git-ignored.
#
#   cp .env.example .env
#
# SQL Server SA password. Must meet complexity rules: 8+ chars with
# uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=Ch4ngeMe_Str0ng!Pass

# Gmail app password for outbound email (rotate the one that was in git history!).
EMAIL_SMTP_PASS=your_gmail_app_password
