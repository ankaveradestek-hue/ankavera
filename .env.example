# Copy this file to ".env" and replace the values. The real .env is git-ignored.
#
#   cp .env.example .env
#
# The database is now file-based SQLite (no server, no password needed). The
# .db file is stored on the "sqlite-data" docker volume mounted at /data.

# Gmail app password for outbound email (rotate the one that was in git history!).
EMAIL_SMTP_PASS=your_gmail_app_password

# Password for the seeded admin account (admin@ankavera.com). Leave empty to
# skip creating the admin user. Must meet the Identity rules (6+ chars, a digit).
SEED_ADMIN_PASSWORD=Ch4ngeMe_Admin!
