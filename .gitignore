## .NET / Visual Studio .gitignore

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET / EF
*.mdf
*.ldf
*.ndf

# Secrets (do NOT commit real credentials)
appsettings.*.local.json
secrets.json
.env
!.env.example

# OS files
.DS_Store
Thumbs.db

# SQLite database files
*.db
*.db-shm
*.db-wal
