@section Scripts {
    <script>
        function showLegal(key) {
            // Panelleri değiştir
            document.querySelectorAll('.legal-panel').forEach(function (p) {
                p.classList.toggle('active', p.getAttribute('data-panel') === key);
            });
            // Sekme (masaüstü + mobil) durumunu güncelle
            document.querySelectorAll('.legal-tab').forEach(function (t) {
                t.classList.toggle('active', t.getAttribute('data-tab') === key);
            });
            // URL hash'ini güncelle (paylaşılabilir link)
            if (history.replaceState) {
                history.replaceState(null, '', '#' + key);
            }
            // İçerik gövdesini başa sar
            var body = document.querySelector('.legal-panel.active .legal-body');
            if (body) body.scrollTop = 0;
        }

        // Sayfa açılışında URL hash'i varsa ilgili sekmeyi aç
        (function () {
            var hash = (window.location.hash || '').replace('#', '').trim();
            var valid = ['mesafeli', 'onbilgi', 'kullanim', 'kvkk', 'gizlilik', 'iade'];
            if (hash && valid.indexOf(hash) !== -1) {
                showLegal(hash);
            }
        })();
    </script>
}
