@model ANKAVERA_İÇ_GİYİM.Models.CartViewModel
@{
    ViewData["Title"] = "Sepetim";
    Layout = "_Layout";
}

<div style="min-height:calc(100vh - 70px); background:#fff5f7; padding:3rem 1rem;">
    <div style="max-width:1150px; margin:0 auto;">

        <!-- Başlık -->
        <div style="text-align:center; margin-bottom:2.5rem;">
            <p style="font-size:0.7rem; font-weight:500; letter-spacing:0.25em;
                text-transform:uppercase; color:#f43f7a; margin-bottom:0.6rem;">
                ✦ Alışveriş ✦
            </p>
            <h1 style="font-family:'Cormorant Garamond',serif; font-size:2.75rem;
                font-weight:300; color:#881337; letter-spacing:0.04em;">
                Sepetim
            </h1>
            <div style="width:2.5rem; height:1px; margin:0.75rem auto;
                background:linear-gradient(90deg,transparent,#f43f7a,transparent);">
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="max-width:600px; margin:0 auto 1.5rem;
                background:#f0fdf4; border:1px solid #bbf7d0;
                border-left:3px solid #22c55e; border-radius:0.75rem;
                padding:0.85rem 1rem; color:#15803d; font-size:0.82rem;">
                ✓ @TempData["SuccessMessage"]
            </div>
        }

        @if (!Model.Items.Any())
        {
            <!-- Boş Sepet -->
            <div style="max-width:440px; margin:0 auto; text-align:center;
                background:white; border-radius:2rem; padding:4rem 2rem;
                box-shadow:0 4px 25px rgba(225,29,72,0.07);">
                <div style="font-size:4rem; margin-bottom:1.25rem;">🛍️</div>
                <h2 style="font-family:'Cormorant Garamond',serif; font-size:1.8rem;
                    font-weight:300; color:#881337; margin-bottom:0.75rem;">
                    Sepetiniz Boş
                </h2>
                <p style="color:#be7094; font-size:0.85rem; font-weight:300;
                    line-height:1.7; margin-bottom:2rem;">
                    Lüks koleksiyonumuzu keşfedip beğendiğiniz ürünleri sepetinize ekleyebilirsiniz.
                </p>
                <a asp-controller="Collections" asp-action="Index"
                   style="display:inline-block; padding:0.9rem 2.25rem;
                    background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                    color:white; border-radius:9999px; font-size:0.8rem;
                    font-weight:600; letter-spacing:0.12em; text-transform:uppercase;
                    text-decoration:none;
                    box-shadow:0 6px 20px rgba(225,29,72,0.3);">
                    Alışverişe Başla
                </a>
            </div>
        }
        else
        {
            <!-- İçerik: Sol + Sağ -->
            <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start;">

                <!-- ── Sol: Ürünler ── -->
                <div style="flex:1; min-width:280px;">
                    <div style="background:white; border-radius:1.5rem; overflow:hidden;
                        box-shadow:0 4px 18px rgba(225,29,72,0.07);">

                        <!-- Tablo Header -->
                        <div style="padding:1.1rem 1.5rem; border-bottom:1px solid #fce7f3;
                            display:flex; justify-content:space-between; align-items:center;">
                            <p style="font-size:0.82rem; font-weight:600; color:#881337;">
                                @Model.ItemCount Ürün
                            </p>
                            <form asp-controller="Cart" asp-action="Clear" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        onclick="return confirm('Sepeti temizlemek istiyor musunuz?')"
                                        style="background:none; border:none; cursor:pointer;
                                    font-size:0.73rem; color:#fca5a5; font-weight:400;
                                    font-family:'Montserrat',sans-serif;">
                                    Sepeti Temizle
                                </button>
                            </form>
                        </div>

                        <!-- Ürün Satırları -->
                        @foreach (var item in Model.Items)
                        {
                            <div style="padding:1.1rem 1.5rem; border-bottom:1px solid #fce7f3;
                                display:flex; gap:1rem; align-items:center;">

                                <!-- Görsel -->
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     style="width:78px; height:78px; object-fit:cover;
                                border-radius:0.875rem; flex-shrink:0;"
                                     onerror="this.src='https://images.unsplash.com/photo-1617922001439-4a2e6562f328?w=200'" />

                                <!-- Bilgi -->
                                <div style="flex:1; min-width:0;">
                                    <p style="font-size:0.67rem; color:#f43f7a;
                                        text-transform:uppercase; letter-spacing:0.1em;
                                        font-weight:500; margin-bottom:0.2rem;">
                                        @item.Category
                                    </p>
                                    <p style="font-family:'Cormorant Garamond',serif;
                                        font-size:1rem; font-weight:400; color:#881337;
                                        margin-bottom:0.35rem; white-space:nowrap;
                                        overflow:hidden; text-overflow:ellipsis;">
                                        @item.Name
                                    </p>
                                    <p style="font-size:0.82rem; font-weight:500; color:#be185d;">
                                        @item.Price.ToString("N0")₺
                                    </p>
                                </div>

                                <!-- Miktar + Sil -->
                                <div style="display:flex; flex-direction:column;
                                    align-items:flex-end; gap:0.5rem; flex-shrink:0;">

                                    <!-- Miktar Kontrolü -->
                                    <div style="display:flex; align-items:center; gap:0.4rem;">
                                        <form asp-controller="Cart" asp-action="Update" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button name="quantity" value="@(item.Quantity - 1)"
                                                    type="submit"
                                                    style="width:28px; height:28px; border-radius:50%;
                                                border:1.5px solid #fce7f3; background:white;
                                                cursor:pointer; font-size:1.1rem;
                                                color:#be185d; display:flex;
                                                align-items:center; justify-content:center;
                                                font-family:'Montserrat',sans-serif;
                                                transition:background 0.2s;"
                                                    onmouseover="this.style.background='#fce7f3'"
                                                    onmouseout="this.style.background='white'">
                                                −
                                            </button>
                                        </form>

                                        <span style="font-size:0.85rem; font-weight:600;
                                            color:#881337; min-width:1.4rem;
                                            text-align:center;">
                                            @item.Quantity
                                        </span>

                                        <form asp-controller="Cart" asp-action="Update" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button name="quantity" value="@(item.Quantity + 1)"
                                                    type="submit"
                                                    style="width:28px; height:28px; border-radius:50%;
                                                border:1.5px solid #fce7f3; background:white;
                                                cursor:pointer; font-size:1.1rem;
                                                color:#be185d; display:flex;
                                                align-items:center; justify-content:center;
                                                font-family:'Montserrat',sans-serif;
                                                transition:background 0.2s;"
                                                    onmouseover="this.style.background='#fce7f3'"
                                                    onmouseout="this.style.background='white'">
                                                +
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Toplam -->
                                    <p style="font-size:0.82rem; font-weight:700; color:#881337;">
                                        @item.Total.ToString("N0")₺
                                    </p>

                                    <!-- Kaldır -->
                                    <form asp-controller="Cart" asp-action="Remove" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit"
                                                style="background:none; border:none; cursor:pointer;
                                            font-size:0.7rem; color:#fca5a5; font-weight:300;
                                            font-family:'Montserrat',sans-serif;">
                                            Kaldır
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    <a asp-controller="Collections" asp-action="Index"
                       style="display:inline-flex; align-items:center; gap:0.3rem;
                        margin-top:1rem; font-size:0.77rem; color:#f43f7a;
                        font-weight:400; text-decoration:none;">
                        ‹ Alışverişe Devam Et
                    </a>
                </div>

                <!-- ── Sağ: Özet ── -->
                <div style="width:290px; flex-shrink:0;">
                    <div style="background:white; border-radius:1.5rem; padding:1.5rem;
                        box-shadow:0 4px 18px rgba(225,29,72,0.07);
                        position:sticky; top:90px;">

                        <h2 style="font-family:'Cormorant Garamond',serif; font-size:1.25rem;
                            font-weight:400; color:#881337; margin-bottom:1.1rem;
                            padding-bottom:0.75rem; border-bottom:1px solid #fce7f3;">
                            Sipariş Özeti
                        </h2>

                        <div style="display:flex; justify-content:space-between;
                            margin-bottom:0.55rem;">
                            <span style="font-size:0.8rem; color:#be7094; font-weight:300;">
                                Ara Toplam
                            </span>
                            <span style="font-size:0.8rem; color:#881337; font-weight:500;">
                                @Model.Subtotal.ToString("N0")₺
                            </span>
                        </div>

                        <div style="display:flex; justify-content:space-between;
                            margin-bottom:0.55rem;">
                            <span style="font-size:0.8rem; color:#be7094; font-weight:300;">
                                Kargo
                            </span>
                            <span style="font-size:0.8rem; font-weight:500;
                                color:@(Model.Shipping == 0 ? "#22c55e" : "#881337")">
                                @(Model.Shipping == 0 ? "Ücretsiz 🎉" : $"{Model.Shipping:N2}₺")
                            </span>
                        </div>

                        @if (Model.Shipping > 0)
                        {
                            <div style="background:#fff5f7; border-radius:0.6rem;
                                padding:0.55rem 0.75rem; margin-bottom:0.75rem;">
                                <p style="font-size:0.7rem; color:#f9a8d4; font-weight:300;
                                    line-height:1.5;">
                                    500₺ üzeri siparişte kargo ücretsiz!
                                    <strong style="color:#be185d;">
                                        @((500 - Model.Subtotal).ToString("N0"))₺
                                    </strong> daha ekleyin.
                                </p>
                            </div>
                        }

                        <div style="display:flex; justify-content:space-between;
                            align-items:center; padding-top:0.9rem;
                            border-top:1px solid #fce7f3; margin-top:0.5rem;
                            margin-bottom:1.1rem;">
                            <span style="font-family:'Cormorant Garamond',serif;
                                font-size:1.1rem; font-weight:500; color:#881337;">
                                Toplam
                            </span>
                            <span style="font-family:'Cormorant Garamond',serif;
                                font-size:1.45rem; font-weight:600; color:#be185d;">
                                @Model.GrandTotal.ToString("N0")₺
                            </span>
                        </div>

                        <a asp-controller="Cart" asp-action="Checkout"
                           style="display:block; width:100%; padding:0.9rem; text-align:center;
                            background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                            color:white; border:none; border-radius:9999px;
                            font-size:0.8rem; font-weight:700;
                            letter-spacing:0.15em; text-transform:uppercase;
                            cursor:pointer; font-family:'Montserrat',sans-serif;
                            text-decoration:none;
                            box-shadow:0 6px 20px rgba(225,29,72,0.3);
                            transition:all 0.3s;"
                           onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 8px 28px rgba(225,29,72,0.45)'"
                           onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 6px 20px rgba(225,29,72,0.3)'">
                            Siparişi Tamamla
                        </a>

                        <p style="text-align:center; font-size:0.68rem; color:#f9a8d4;
                            font-weight:300; margin-top:0.65rem;">
                            🔒 Güvenli ödeme
                        </p>

                        <!-- İade Uyarısı -->
                        <div style="margin-top:1rem; padding:0.75rem;
                            background:#fff5f7; border-radius:0.7rem;
                            border-left:2px solid #f43f7a;">
                            <p style="font-size:0.68rem; color:#be7094;
                                font-weight:300; line-height:1.55;">
                                ⚠️ Hijyen koşulları gereği iç giyim ürünlerinde
                                <strong style="color:#be185d;">
                                    iade ve değişim yapılmamaktadır.
                                </strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>