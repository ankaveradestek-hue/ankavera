@model ANKAVERA_İÇ_GİYİM.Models.ProductViewModel
@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "_Layout";
    var cats = ViewData["Categories"] as List<string> ?? new();
}

<div style="min-height:calc(100vh - 70px);background:#fff5f7;padding:2.5rem 1rem;">
    <div style="max-width:820px;margin:0 auto;">

        <!-- Geri + Başlık -->
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;">
            <a href="/Admin/Products"
               style="width:38px;height:38px;border-radius:50%;background:white;
                display:flex;align-items:center;justify-content:center;
                box-shadow:0 2px 10px rgba(225,29,72,.1);text-decoration:none;
                color:#881337;font-size:1.1rem;flex-shrink:0;">
                ←
            </a>
            <div>
                <p style="font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;
                    color:#f43f7a;font-weight:500;margin-bottom:.2rem;">
                    ✦ Ürün Yönetimi ✦
                </p>
                <h1 style="font-family:'Cormorant Garamond',serif;font-size:2rem;
                    font-weight:300;color:#881337;">
                    Yeni Ürün Ekle
                </h1>
            </div>
        </div>

        <div style="background:white;border-radius:1.75rem;overflow:hidden;
            box-shadow:0 10px 40px rgba(225,29,72,.1);">

            <!-- Form Header -->
            <div style="padding:1.5rem 2rem;
                background:linear-gradient(135deg,#fff5f7,white);
                border-bottom:1px solid #fce7f3;">
                <p style="font-size:.8rem;color:#be7094;font-weight:300;">
                    Tüm alanları eksiksiz doldurun. Görsel olarak dosya yükleyebilir veya URL girebilirsiniz.
                </p>
            </div>

            <div style="padding:2rem;">

                <!-- Hatalar -->
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div style="background:#fff1f2;border:1px solid #fecdd3;
                        border-left:3px solid #e11d48;border-radius:.75rem;
                        padding:.9rem 1rem;margin-bottom:1.5rem;">
                        @foreach (var ms in ViewData.ModelState.Values)
                        {
                            foreach (var err in ms.Errors)
                            {
                                <p style="color:#be123c;font-size:.78rem;margin:0 0 .2rem;">
                                    ⚠ @err.ErrorMessage
                                </p>
                            }
                        }
                    </div>
                }

                <form method="post"
                      action="/Admin/AddProduct"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <!-- ── Temel Bilgiler ── -->
                    <div style="margin-bottom:2rem;">
                        <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;
                            font-weight:400;color:#881337;margin-bottom:1.25rem;
                            padding-bottom:.6rem;border-bottom:1px solid #fce7f3;">
                            📝 Temel Bilgiler
                        </h3>

                        <div style="display:grid;grid-template-columns:1fr 1fr;
                            gap:1.1rem;margin-bottom:1.1rem;">

                            <!-- Ürün Adı -->
                            <div style="grid-column:1/-1;">
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Ürün Adı *
                                </label>
                                <input name="Name"
                                       value="@Model.Name"
                                       placeholder="Örn: Pembe Saten Takım"
                                       required
                                       style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                transition:border-color .25s;"
                                       onfocus="this.style.borderColor='#f43f7a'"
                                       onblur="this.style.borderColor='#fce7f3'" />
                            </div>

                            <!-- Kategori -->
                            <div>
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Kategori *
                                </label>
                                <select name="CategoryName"
                                        required
                                        style="width:100%;padding:.75rem 1rem;
                                    border:1.5px solid #fce7f3;border-radius:.8rem;
                                    font-size:.875rem;color:#4a1942;outline:none;
                                    font-family:'Montserrat',sans-serif;background:white;
                                    cursor:pointer;"
                                        onfocus="this.style.borderColor='#f43f7a'"
                                        onblur="this.style.borderColor='#fce7f3'">
                                    <option value="">-- Seçiniz --</option>
                                    @foreach (var c in cats)
                                    {
                                        <option value="@c" @(Model.CategoryName == c ? "selected" : "")>
                                            @c
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Fiyat -->
                            <div>
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Fiyat (₺) *
                                </label>
                                <input name="Price"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       value="@Model.Price"
                                       placeholder="0.00"
                                       required
                                       style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                transition:border-color .25s;"
                                       onfocus="this.style.borderColor='#f43f7a'"
                                       onblur="this.style.borderColor='#fce7f3'" />
                            </div>

                            <!-- Stok -->
                            <div>
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Stok Adedi
                                </label>
                                <input name="StockCount"
                                       type="number"
                                       min="0"
                                       value="@Model.StockCount"
                                       style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                transition:border-color .25s;"
                                       onfocus="this.style.borderColor='#f43f7a'"
                                       onblur="this.style.borderColor='#fce7f3'" />
                            </div>

                            <!-- Rozet -->
                            <div>
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Rozet (Opsiyonel)
                                </label>
                                <select name="Badge"
                                        style="width:100%;padding:.75rem 1rem;
                                    border:1.5px solid #fce7f3;border-radius:.8rem;
                                    font-size:.875rem;color:#4a1942;outline:none;
                                    font-family:'Montserrat',sans-serif;background:white;
                                    cursor:pointer;"
                                        onfocus="this.style.borderColor='#f43f7a'"
                                        onblur="this.style.borderColor='#fce7f3'">
                                    <option value="">Yok</option>
                                    @foreach (var b in new[] { "Yeni", "Çok Satan", "Özel", "İndirim", "Sınırlı" })
                                    {
                                        <option value="@b" @(Model.Badge == b ? "selected" : "")>@b</option>
                                    }
                                </select>
                            </div>

                            <!-- Açıklama -->
                            <div style="grid-column:1/-1;">
                                <label style="display:block;font-size:.68rem;font-weight:700;
                                    letter-spacing:.12em;text-transform:uppercase;
                                    color:#9d4b7a;margin-bottom:.4rem;">
                                    Açıklama *
                                </label>
                                <textarea name="Description"
                                          rows="3"
                                          placeholder="Ürün hakkında kısa açıklama..."
                                          required
                                          style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                resize:vertical;transition:border-color .25s;"
                                          onfocus="this.style.borderColor='#f43f7a'"
                                          onblur="this.style.borderColor='#fce7f3'">@Model.Description</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- ── Görsel ── -->
                    <div style="margin-bottom:2rem;">
                        <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;
                            font-weight:400;color:#881337;margin-bottom:1.25rem;
                            padding-bottom:.6rem;border-bottom:1px solid #fce7f3;">
                            🖼️ Ürün Görseli
                        </h3>

                        <!-- Dosya Yükle -->
                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Dosya Yükle (JPG, PNG, WEBP)
                            </label>
                            <div style="border:2px dashed #fce7f3;border-radius:.875rem;
                                padding:1.5rem;text-align:center;background:#fffbfd;
                                cursor:pointer;transition:border-color .25s;"
                                 id="drop-zone"
                                 onclick="document.getElementById('img-file').click()"
                                 ondragover="event.preventDefault();this.style.borderColor='#f43f7a'"
                                 ondragleave="this.style.borderColor='#fce7f3'"
                                 ondrop="handleDrop(event)">
                                <div id="preview-wrap"
                                     style="margin-bottom:.75rem;">
                                    <svg width="40" height="40" fill="none" stroke="#f9a8d4"
                                         stroke-width="1.5" viewBox="0 0 24 24"
                                         style="margin:0 auto;">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="17 8 12 3 7 8" />
                                        <line x1="12" y1="3" x2="12" y2="15" />
                                    </svg>
                                </div>
                                <p style="font-size:.8rem;color:#be7094;font-weight:300;">
                                    Tıklayın veya sürükleyin
                                </p>
                                <p style="font-size:.72rem;color:#d4a0b4;font-weight:300;
                                    margin-top:.25rem;">
                                    Maks. 5MB · JPG, PNG, WEBP, GIF
                                </p>
                            </div>
                            <input type="file"
                                   name="ImageFile"
                                   id="img-file"
                                   accept=".jpg,.jpeg,.png,.webp,.gif"
                                   style="display:none;"
                                   onchange="previewImage(this)" />
                        </div>

                        <!-- VEYA URL -->
                        <div style="display:flex;align-items:center;gap:.75rem;
                            margin-bottom:.75rem;">
                            <div style="flex:1;height:1px;background:#fce7f3;"></div>
                            <span style="font-size:.72rem;color:#d4a0b4;font-weight:300;">
                                veya URL girin
                            </span>
                            <div style="flex:1;height:1px;background:#fce7f3;"></div>
                        </div>

                        <input name="ImageUrl"
                               value="@Model.ImageUrl"
                               placeholder="https://ornek.com/resim.jpg"
                               type="url"
                               style="width:100%;padding:.75rem 1rem;
                        border:1.5px solid #fce7f3;border-radius:.8rem;
                        font-size:.875rem;color:#4a1942;outline:none;
                        font-family:'Montserrat',sans-serif;background:white;
                        transition:border-color .25s;"
                               onfocus="this.style.borderColor='#f43f7a'"
                               onblur="this.style.borderColor='#fce7f3'"
                               oninput="previewUrl(this.value)" />

                        <!-- Önizleme -->
                        <div id="img-preview"
                             style="margin-top:.75rem;display:none;">
                            <img id="preview-img"
                                 style="width:120px;height:120px;object-fit:cover;
                            border-radius:.875rem;
                            box-shadow:0 4px 15px rgba(225,29,72,.15);" />
                        </div>
                    </div>

                    <!-- ── Ayarlar ── -->
                    <div style="margin-bottom:2rem;">
                        <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;
                            font-weight:400;color:#881337;margin-bottom:1.25rem;
                            padding-bottom:.6rem;border-bottom:1px solid #fce7f3;">
                            ⚙️ Ürün Ayarları
                        </h3>

                        <div style="display:flex;flex-wrap:wrap;gap:1rem;">

                            @foreach (var opt in new[]{
                            ("IsActive",     "IsActive",     "✅ Aktif (Satışta)",    Model.IsActive),
                            ("IsNew",        "IsNew",        "🆕 Yeni Ürün",          Model.IsNew),
                            ("IsBestseller", "IsBestseller", "🔥 Çok Satan",          Model.IsBestseller),
                        })
                            {
                                <label style="display:flex;align-items:center;gap:.6rem;
                                    cursor:pointer;padding:.75rem 1.25rem;
                                    border:1.5px solid #fce7f3;border-radius:.875rem;
                                    background:white;transition:all .2s;"
                                       onmouseover="this.style.background='#fff5f7'"
                                       onmouseout="this.style.background='white'">
                                    <input type="checkbox"
                                           name="@opt.Item2"
                                           value="true"
                                    @(opt.Item4 ? "checked" : "")
                                           style="width:1rem;height:1rem;
                                    accent-color:#e11d48;cursor:pointer;" />
                                    <span style="font-size:.8rem;color:#881337;font-weight:500;">
                                        @opt.Item3
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- ── Kaydet ── -->
                    <div style="display:flex;gap:.75rem;justify-content:flex-end;
                        padding-top:1.25rem;border-top:1px solid #fce7f3;">
                        <a href="/Admin/Products"
                           style="padding:.85rem 1.75rem;border-radius:9999px;
                            border:1.5px solid #fce7f3;background:white;
                            color:#881337;font-size:.8rem;font-weight:500;
                            text-decoration:none;transition:all .2s;">
                            İptal
                        </a>
                        <button type="submit"
                                style="padding:.85rem 2rem;border-radius:9999px;
                            background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                            color:white;border:none;cursor:pointer;
                            font-size:.8rem;font-weight:700;letter-spacing:.1em;
                            text-transform:uppercase;
                            font-family:'Montserrat',sans-serif;
                            box-shadow:0 6px 20px rgba(225,29,72,.35);
                            transition:all .3s;"
                                onmouseover="this.style.transform='translateY(-1px)'"
                                onmouseout="this.style.transform='translateY(0)'">
                            ✓ Ürünü Kaydet
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function(e) {
                showPreview(e.target.result);
            };
            reader.readAsDataURL(input.files[0]);

            // Drop zone'u güncelle
            var dz = document.getElementById('drop-zone');
            if (dz) dz.style.borderColor = '#22c55e';
        }

        function previewUrl(url) {
            if (!url) { hidePreview(); return; }
            showPreview(url);
        }

        function showPreview(src) {
            var wrap = document.getElementById('img-preview');
            var img  = document.getElementById('preview-img');
            if (wrap && img) {
                img.src = src;
                wrap.style.display = 'block';
            }
        }

        function hidePreview() {
            var wrap = document.getElementById('img-preview');
            if (wrap) wrap.style.display = 'none';
        }

        function handleDrop(e) {
            e.preventDefault();
            var dz = document.getElementById('drop-zone');
            if (dz) dz.style.borderColor = '#fce7f3';

            var file = e.dataTransfer.files[0];
            if (!file) return;

            var inp = document.getElementById('img-file');
            var dt  = new DataTransfer();
            dt.items.add(file);
            inp.files = dt.files;
            previewImage(inp);
        }
    </script>
}