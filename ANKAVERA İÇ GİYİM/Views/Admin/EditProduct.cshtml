@model ANKAVERA_İÇ_GİYİM.Models.ProductViewModel
@{
    ViewData["Title"] = "Ürün Düzenle";
    Layout = "_Layout";
    var cats = ViewData["Categories"] as List<string> ?? new();
}

<div style="min-height:calc(100vh - 70px);background:#fff5f7;padding:2.5rem 1rem;">
    <div style="max-width:820px;margin:0 auto;">

        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;">
            <a href="/Admin/Products"
               style="width:38px;height:38px;border-radius:50%;background:white;
                display:flex;align-items:center;justify-content:center;
                box-shadow:0 2px 10px rgba(225,29,72,.1);text-decoration:none;
                color:#881337;font-size:1.1rem;flex-shrink:0;">
                ←
            </a>
            <div>
                <p style="font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;
                    color:#f43f7a;font-weight:500;margin-bottom:.2rem;">
                    ✦ Ürün Yönetimi ✦
                </p>
                <h1 style="font-family:'Cormorant Garamond',serif;font-size:2rem;
                    font-weight:300;color:#881337;">
                    Ürünü Düzenle
                </h1>
            </div>
        </div>

        <div style="background:white;border-radius:1.75rem;overflow:hidden;
            box-shadow:0 10px 40px rgba(225,29,72,.1);">

            <div style="padding:1.5rem 2rem;border-bottom:1px solid #fce7f3;
                background:linear-gradient(135deg,#fff5f7,white);
                display:flex;align-items:center;justify-content:space-between;">
                <p style="font-size:.8rem;color:#be7094;font-weight:300;">
                    ID: #@Model.Id · Değişiklikler anında yayınlanır.
                </p>
                <!-- Anlık Sil -->
                <form method="post" action="/Admin/DeleteProduct"
                      style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit"
                            onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?')"
                            style="padding:.4rem 1rem;border-radius:9999px;
                        border:1.5px solid #fecdd3;background:white;
                        font-size:.75rem;color:#e11d48;cursor:pointer;
                        font-family:'Montserrat',sans-serif;font-weight:500;">
                        🗑 Ürünü Sil
                    </button>
                </form>
            </div>

            <div style="padding:2rem;">

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div style="background:#fff1f2;border-left:3px solid #e11d48;
                        border-radius:.75rem;padding:.9rem 1rem;margin-bottom:1.5rem;">
                        @foreach (var ms in ViewData.ModelState.Values)
                        {
                            foreach (var err in ms.Errors)
                            {
                                <p style="color:#be123c;font-size:.78rem;margin:0 0 .2rem;">
                                    ⚠ @err.ErrorMessage
                                </p>
                            }
                        }
                    </div>
                }

                <form method="post"
                      action="/Admin/EditProduct/@Model.Id"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ExistingImageUrl"
                           value="@Model.ExistingImageUrl" />

                    <!-- Mevcut Görsel -->
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <div style="margin-bottom:1.5rem;padding:1rem;
                            background:#fff5f7;border-radius:1rem;
                            display:flex;align-items:center;gap:1rem;">
                            <img src="@Model.ExistingImageUrl"
                                 alt="Mevcut görsel"
                                 style="width:80px;height:80px;object-fit:cover;
                            border-radius:.75rem;" />
                            <div>
                                <p style="font-size:.75rem;font-weight:600;color:#881337;
                                    margin-bottom:.2rem;">
                                    Mevcut Görsel
                                </p>
                                <p style="font-size:.7rem;color:#be7094;font-weight:300;">
                                    Yeni dosya yükler veya URL girerseniz güncellenir.
                                </p>
                            </div>
                        </div>
                    }

                    <!-- Temel Bilgiler -->
                    <div style="display:grid;grid-template-columns:1fr 1fr;
                        gap:1.1rem;margin-bottom:1.5rem;">

                        <div style="grid-column:1/-1;">
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Ürün Adı *
                            </label>
                            <input name="Name"
                                   value="@Model.Name"
                                   required
                                   style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;"
                                   onfocus="this.style.borderColor='#f43f7a'"
                                   onblur="this.style.borderColor='#fce7f3'" />
                        </div>

                        <div>
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Kategori *
                            </label>
                            <select name="CategoryName" required
                                    style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;cursor:pointer;"
                                    onfocus="this.style.borderColor='#f43f7a'"
                                    onblur="this.style.borderColor='#fce7f3'">
                                @foreach (var c in cats)
                                {
                                    <option value="@c" @(Model.CategoryName == c ? "selected" : "")>@c</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Fiyat (₺) *
                            </label>
                            <input name="Price"
                                   type="number" step="0.01" min="0"
                                   value="@Model.Price"
                                   required
                                   style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;"
                                   onfocus="this.style.borderColor='#f43f7a'"
                                   onblur="this.style.borderColor='#fce7f3'" />
                        </div>

                        <div>
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Stok
                            </label>
                            <input name="StockCount"
                                   type="number" min="0"
                                   value="@Model.StockCount"
                                   style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;"
                                   onfocus="this.style.borderColor='#f43f7a'"
                                   onblur="this.style.borderColor='#fce7f3'" />
                        </div>

                        <div>
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Rozet
                            </label>
                            <select name="Badge"
                                    style="width:100%;padding:.75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;cursor:pointer;"
                                    onfocus="this.style.borderColor='#f43f7a'"
                                    onblur="this.style.borderColor='#fce7f3'">
                                <option value="">Yok</option>
                                @foreach (var b in new[] { "Yeni", "Çok Satan", "Özel", "İndirim", "Sınırlı" })
                                {
                                    <option value="@b" @(Model.Badge == b ? "selected" : "")>@b</option>
                                }
                            </select>
                        </div>

                        <div style="grid-column:1/-1;">
                            <label style="display:block;font-size:.68rem;font-weight:700;
                                letter-spacing:.12em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Açıklama *
                            </label>
                            <textarea name="Description" rows="3" required
                                      style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;
                            resize:vertical;"
                                      onfocus="this.style.borderColor='#f43f7a'"
                                      onblur="this.style.borderColor='#fce7f3'">@Model.Description</textarea>
                        </div>
                    </div>

                    <!-- Görsel Güncelle -->
                    <div style="margin-bottom:1.5rem;">
                        <h3 style="font-size:.75rem;font-weight:700;letter-spacing:.12em;
                            text-transform:uppercase;color:#9d4b7a;margin-bottom:.75rem;">
                            Görsel Güncelle (Opsiyonel)
                        </h3>
                        <input type="file" name="ImageFile"
                               accept=".jpg,.jpeg,.png,.webp,.gif"
                               onchange="previewNew(this)"
                               style="font-size:.8rem;color:#881337;cursor:pointer;" />
                        <p style="font-size:.7rem;color:#d4a0b4;font-weight:300;margin-top:.3rem;">
                            Boş bırakırsanız mevcut görsel korunur.
                        </p>

                        <div style="margin-top:.75rem;">
                            <label style="font-size:.68rem;font-weight:700;letter-spacing:.12em;
                                text-transform:uppercase;color:#9d4b7a;display:block;
                                margin-bottom:.4rem;">
                                Veya Yeni URL
                            </label>
                            <input name="ImageUrl"
                                   value="@Model.ImageUrl"
                                   placeholder="https://..."
                                   type="url"
                                   style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;"
                                   onfocus="this.style.borderColor='#f43f7a'"
                                   onblur="this.style.borderColor='#fce7f3'" />
                        </div>

                        <div id="new-preview" style="margin-top:.75rem;display:none;">
                            <img id="new-preview-img"
                                 style="width:100px;height:100px;object-fit:cover;
                            border-radius:.75rem;" />
                        </div>
                    </div>

                    <!-- Ayarlar -->
                    <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
                        @foreach (var opt in new[]{
                        ("IsActive",     "✅ Aktif",      Model.IsActive),
                        ("IsNew",        "🆕 Yeni Ürün",  Model.IsNew),
                        ("IsBestseller", "🔥 Çok Satan",  Model.IsBestseller),
                    })
                        {
                            <label style="display:flex;align-items:center;gap:.6rem;cursor:pointer;
                                padding:.65rem 1.1rem;border:1.5px solid #fce7f3;
                                border-radius:.875rem;background:white;transition:all .2s;"
                                   onmouseover="this.style.background='#fff5f7'"
                                   onmouseout="this.style.background='white'">
                                <input type="checkbox"
                                       name="@opt.Item1"
                                       value="true"
                                @(opt.Item3 ? "checked" : "")
                                       style="width:1rem;height:1rem;accent-color:#e11d48;" />
                                <span style="font-size:.8rem;color:#881337;font-weight:500;">
                                    @opt.Item2
                                </span>
                            </label>
                        }
                    </div>

                    <!-- Kaydet -->
                    <div style="display:flex;gap:.75rem;justify-content:flex-end;
                        padding-top:1.25rem;border-top:1px solid #fce7f3;">
                        <a href="/Admin/Products"
                           style="padding:.85rem 1.75rem;border-radius:9999px;
                            border:1.5px solid #fce7f3;background:white;
                            color:#881337;font-size:.8rem;font-weight:500;
                            text-decoration:none;">
                            İptal
                        </a>
                        <button type="submit"
                                style="padding:.85rem 2rem;border-radius:9999px;
                            background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                            color:white;border:none;cursor:pointer;
                            font-size:.8rem;font-weight:700;letter-spacing:.1em;
                            text-transform:uppercase;
                            font-family:'Montserrat',sans-serif;
                            box-shadow:0 6px 20px rgba(225,29,72,.35);">
                            ✓ Değişiklikleri Kaydet
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewNew(input) {
            if (!input.files || !input.files[0]) return;
            var reader = new FileReader();
            reader.onload = function(e) {
                var w = document.getElementById('new-preview');
                var i = document.getElementById('new-preview-img');
                if (w && i) { i.src = e.target.result; w.style.display = 'block'; }
            };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}