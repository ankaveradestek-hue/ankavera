@{
    ViewData["Title"] = "Şifre Yenile";
    Layout = "_Layout";
    var userId = ViewData["UserId"]?.ToString() ?? "";
    var token = ViewData["Token"]?.ToString() ?? "";
    bool resetOk = ViewData["ResetSuccess"] != null;
}

<div style="min-height:calc(100vh - 70px);display:flex;align-items:center;
    justify-content:center;padding:3rem 1rem;
    background:linear-gradient(145deg,#fff5f7,#fce7f3,#fff0f5);">

    <div style="width:100%;max-width:420px;">
        <div style="background:white;border-radius:1.75rem;overflow:hidden;
            box-shadow:0 25px 60px rgba(225,29,72,.12);">

            <div style="padding:2.25rem 2rem 1.25rem;text-align:center;
                background:linear-gradient(180deg,#fff5f7,white);">
                <div style="font-size:2.5rem;margin-bottom:1rem;">🔒</div>
                <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.9rem;
                    font-weight:300;color:#881337;margin:0 0 .25rem;">
                    Yeni Şifre Belirle
                </h1>
                <div style="width:2.5rem;height:1px;margin:.9rem auto 0;
                    background:linear-gradient(90deg,transparent,#f43f7a,transparent);">
                </div>
            </div>

            <div style="padding:1.5rem 2rem 2.25rem;">

                @if (resetOk)
                {
                    <div style="text-align:center;padding:1rem 0;">
                        <div style="font-size:3rem;margin-bottom:1rem;">✅</div>
                        <p style="color:#15803d;font-size:.9rem;font-weight:400;
                            margin:0 0 1.5rem;">
                            Şifreniz başarıyla güncellendi!
                        </p>
                        <a href="/Account/Login"
                           style="display:inline-block;padding:.85rem 2rem;
                            background:linear-gradient(135deg,#f472b6,#e11d48);
                            color:white;border-radius:9999px;font-size:.8rem;
                            font-weight:600;letter-spacing:.1em;text-decoration:none;">
                            Giriş Yap
                        </a>
                    </div>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div style="background:#fff1f2;border-left:3px solid #e11d48;
                            border-radius:.75rem;padding:.8rem 1rem;
                            margin-bottom:1.25rem;">
                            @foreach (var ms in ViewData.ModelState.Values)
                            {
                                foreach (var err in ms.Errors)
                                {
                                    <p style="color:#be123c;font-size:.78rem;margin:0 0 .2rem;">
                                        ⚠ @err.ErrorMessage
                                    </p>
                                }
                            }
                        </div>
                    }

                    <form method="post" action="/Account/ResetPassword">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@userId" />
                        <input type="hidden" name="token" value="@token" />

                        <!-- Yeni Şifre -->
                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:.67rem;font-weight:700;
                                letter-spacing:.14em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Yeni Şifre
                            </label>
                            <div style="position:relative;">
                                <input name="newPassword"
                                       type="password"
                                       id="new-pwd"
                                       placeholder="En az 6 karakter"
                                       required
                                       minlength="6"
                                       style="width:100%;padding:.75rem 2.8rem .75rem 1rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                transition:border-color .25s;"
                                       onfocus="this.style.borderColor='#f43f7a'"
                                       onblur="this.style.borderColor='#fce7f3'" />
                                <button type="button"
                                        onclick="eyeT('new-pwd','eye-np')"
                                        tabindex="-1"
                                        style="position:absolute;right:10px;top:50%;
                                    transform:translateY(-50%);background:none;
                                    border:none;cursor:pointer;padding:4px;
                                    color:#f9a8d4;display:flex;align-items:center;">
                                    <svg id="eye-np" width="16" height="16" fill="none"
                                         stroke="currentColor" stroke-width="1.8"
                                         viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Şifre Tekrar -->
                        <div style="margin-bottom:1.5rem;">
                            <label style="display:block;font-size:.67rem;font-weight:700;
                                letter-spacing:.14em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                Şifre Tekrarı
                            </label>
                            <input name="confirmPassword"
                                   type="password"
                                   placeholder="Şifrenizi tekrar giriniz"
                                   required
                                   style="width:100%;padding:.75rem 1rem;
                            border:1.5px solid #fce7f3;border-radius:.8rem;
                            font-size:.875rem;color:#4a1942;outline:none;
                            font-family:'Montserrat',sans-serif;background:white;
                            transition:border-color .25s;"
                                   onfocus="this.style.borderColor='#f43f7a'"
                                   onblur="this.style.borderColor='#fce7f3'" />
                        </div>

                        <button type="submit"
                                style="width:100%;padding:.9rem;border:none;cursor:pointer;
                            background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                            color:white;font-size:.8rem;font-weight:700;
                            letter-spacing:.2em;text-transform:uppercase;
                            border-radius:9999px;font-family:'Montserrat',sans-serif;
                            box-shadow:0 6px 20px rgba(225,29,72,.35);">
                            Şifremi Güncelle
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function eyeT(id, eid) {
            var i = document.getElementById(id);
            var e = document.getElementById(eid);
            if (!i || !e) return;
            if (i.type === 'password') {
                i.type = 'text';
                e.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                i.type = 'password';
                e.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }
    </script>
}