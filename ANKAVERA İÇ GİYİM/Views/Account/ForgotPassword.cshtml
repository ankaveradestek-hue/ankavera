@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_Layout";
    bool sent = ViewData["EmailSent"] != null;
    var sentTo = ViewData["SentTo"]?.ToString() ?? "";
}

<div style="min-height:calc(100vh - 70px);display:flex;align-items:center;
    justify-content:center;padding:3rem 1rem;
    background:linear-gradient(145deg,#fff5f7,#fce7f3,#fff0f5);">

    <div style="width:100%;max-width:420px;">
        <div style="background:white;border-radius:1.75rem;overflow:hidden;
            box-shadow:0 25px 60px rgba(225,29,72,.12);">

            <div style="padding:2.25rem 2rem 1.25rem;text-align:center;
                background:linear-gradient(180deg,#fff5f7,white);">
                <div style="font-size:2.5rem;margin-bottom:1rem;">🔑</div>
                <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.9rem;
                    font-weight:300;color:#881337;margin:0 0 .25rem;">
                    Şifremi Unuttum
                </h1>
                <p style="color:#d4789a;font-size:.78rem;font-weight:300;margin:0;">
                    E-postanıza sıfırlama linki gönderilecek
                </p>
                <div style="width:2.5rem;height:1px;margin:.9rem auto 0;
                    background:linear-gradient(90deg,transparent,#f43f7a,transparent);">
                </div>
            </div>

            <div style="padding:1.5rem 2rem 2.25rem;">

                @if (sent)
                {
                    <div style="background:#f0fdf4;border:1px solid #bbf7d0;
                        border-left:3px solid #22c55e;border-radius:.75rem;
                        padding:1rem;text-align:center;">
                        <p style="color:#15803d;font-size:.85rem;font-weight:400;
                            margin:0 0 .5rem;">
                            ✓ Şifre sıfırlama e-postası gönderildi!
                        </p>
                        <p style="color:#166534;font-size:.78rem;font-weight:300;margin:0;">
                            <strong>@sentTo</strong> adresini kontrol edin.
                        </p>
                    </div>

                    <a href="/Account/Login"
                       style="display:block;text-align:center;margin-top:1.25rem;
                        font-size:.78rem;color:#f43f7a;text-decoration:none;">
                        ← Giriş sayfasına dön
                    </a>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div style="background:#fff1f2;border-left:3px solid #e11d48;
                            border-radius:.75rem;padding:.8rem 1rem;
                            margin-bottom:1.25rem;">
                            @foreach (var ms in ViewData.ModelState.Values)
                            {
                                foreach (var err in ms.Errors)
                                {
                                    <p style="color:#be123c;font-size:.78rem;margin:0;">
                                        ⚠ @err.ErrorMessage
                                    </p>
                                }
                            }
                        </div>
                    }

                    <form method="post" action="/Account/ForgotPassword">
                        @Html.AntiForgeryToken()

                        <div style="margin-bottom:1.25rem;">
                            <label style="display:block;font-size:.67rem;font-weight:700;
                                letter-spacing:.14em;text-transform:uppercase;
                                color:#9d4b7a;margin-bottom:.4rem;">
                                E-posta Adresiniz
                            </label>
                            <div style="position:relative;">
                                <span style="position:absolute;left:12px;top:50%;
                                    transform:translateY(-50%);pointer-events:none;
                                    display:flex;align-items:center;">
                                    <svg width="15" height="15" fill="none" stroke="#f9a8d4"
                                         stroke-width="1.8" viewBox="0 0 24 24">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                        <polyline points="22,6 12,13 2,6" />
                                    </svg>
                                </span>
                                <input name="email"
                                       type="email"
                                       placeholder="kayitli@email.com"
                                       required
                                       style="width:100%;padding:.75rem 1rem .75rem 2.5rem;
                                border:1.5px solid #fce7f3;border-radius:.8rem;
                                font-size:.875rem;color:#4a1942;outline:none;
                                font-family:'Montserrat',sans-serif;background:white;
                                transition:border-color .25s;"
                                       onfocus="this.style.borderColor='#f43f7a'"
                                       onblur="this.style.borderColor='#fce7f3'" />
                            </div>
                        </div>

                        <button type="submit"
                                style="width:100%;padding:.9rem;border:none;cursor:pointer;
                            background:linear-gradient(135deg,#f472b6,#e11d48,#be185d);
                            color:white;font-size:.8rem;font-weight:700;
                            letter-spacing:.2em;text-transform:uppercase;
                            border-radius:9999px;font-family:'Montserrat',sans-serif;
                            box-shadow:0 6px 20px rgba(225,29,72,.35);
                            margin-bottom:1.1rem;">
                            Sıfırlama Linki Gönder
                        </button>

                        <p style="text-align:center;font-size:.78rem;
                            color:#be7094;font-weight:300;">
                            <a href="/Account/Login"
                               style="color:#e11d48;text-decoration:underline;">
                                ← Giriş sayfasına dön
                            </a>
                        </p>
                    </form>
                }
            </div>
        </div>
    </div>
</div>