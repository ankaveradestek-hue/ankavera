@model ANKAVERA_İÇ_GİYİM.Models.Order

@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "_Layout"; // Kendi admin layout adınızla değiştirin
}

<div class="p-6 space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Sipariş #@Model.Id</h1>
            <p class="text-sm text-gray-500 mt-1">Sipariş detaylarını aşağıda görüntüleyebilirsiniz.</p>
        </div>
        <a asp-controller="Order" asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-gray-200 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Listeye Dön
        </a>
    </div>

    <!-- Bildirimler -->
    @if (TempData["OrderSuccess"] != null)
    {
        <div class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
            ✓ @TempData["OrderSuccess"]
        </div>
    }
    @if (TempData["OrderError"] != null)
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            ⚠️ @TempData["OrderError"]
        </div>
    }

    <!-- Üst Bilgi Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Sipariş Bilgileri -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Sipariş Bilgileri</h2>
            <dl class="space-y-4">
                <div class="flex items-center justify-between">
                    <dt class="text-sm text-gray-500">Sipariş Tarihi</dt>
                    <dd class="text-sm font-medium text-gray-900">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-sm text-gray-500">Sipariş Durumu</dt>
                    <dd>
                        @{
                            var badgeClass = Model.OrderStatus switch
                            {
                                "Beklemede" => "bg-yellow-50 text-yellow-700 ring-yellow-600/20",
                                "Onaylandı" => "bg-blue-50 text-blue-700 ring-blue-600/20",
                                "Kargoda" => "bg-indigo-50 text-indigo-700 ring-indigo-600/20",
                                "Teslim Edildi" => "bg-green-50 text-green-700 ring-green-600/20",
                                "İptal Edildi" => "bg-red-50 text-red-700 ring-red-600/20",
                                _ => "bg-gray-50 text-gray-700 ring-gray-600/20"
                            };
                        }
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium ring-1 ring-inset @badgeClass">
                            @Model.OrderStatus
                        </span>
                    </dd>
                </div>
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <dt class="text-sm text-gray-500">Toplam Tutar</dt>
                    <dd class="text-lg font-bold text-gray-900">@Model.TotalPrice.ToString("N2") ₺</dd>
                </div>
            </dl>
        </div>

        <!-- İletişim / Adres Bilgileri -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">İletişim ve Adres Bilgileri</h2>
            <dl class="space-y-4">
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <div>
                        <dt class="text-xs text-gray-500">Müşteri</dt>
                        <dd class="text-sm font-medium text-gray-900">@Model.CustomerName</dd>
                        <dd class="text-sm text-gray-600">@Model.CustomerEmail</dd>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <div>
                        <dt class="text-xs text-gray-500">Telefon</dt>
                        <dd class="text-sm font-medium text-gray-900">@Model.PhoneNumber</dd>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <div>
                        <dt class="text-xs text-gray-500">Şehir</dt>
                        <dd class="text-sm font-medium text-gray-900">@Model.City</dd>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <div>
                        <dt class="text-xs text-gray-500">Adres</dt>
                        <dd class="text-sm font-medium text-gray-900">@Model.ShippingAddress</dd>
                    </div>
                </div>
            </dl>
        </div>
    </div>

    <!-- Sipariş İçeriği -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Sipariş İçeriği</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Ürün Adı</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Adet</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Birim Fiyat</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Ara Toplam</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        foreach (var item in Model.OrderItems)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    @item.Product.Name
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 text-center">
                                    @item.Quantity
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 text-right">
                                    @item.UnitPrice.ToString("N2") ₺
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900 text-right">
                                    @((item.UnitPrice * item.Quantity).ToString("N2")) ₺
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">
                                Bu siparişe ait ürün bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-gray-50">
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-right text-sm font-semibold text-gray-700">Genel Toplam</td>
                        <td class="px-6 py-4 text-right text-base font-bold text-gray-900">@Model.TotalPrice.ToString("N2") ₺</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ═══════════ Kargo & Durum Yönetimi (Admin) ═══════════ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Kargoya Ver -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                🚚 Kargoya Ver & Müşteriye Bildir
            </h2>

            @if (!string.IsNullOrWhiteSpace(Model.CargoTrackingNumber))
            {
                <div class="mb-4 rounded-lg bg-indigo-50 border border-indigo-100 px-4 py-3">
                    <p class="text-xs text-indigo-500 uppercase tracking-wider">Mevcut Kargo Bilgisi</p>
                    <p class="text-sm font-medium text-indigo-900 mt-1">
                        @Model.CargoCompany · <span class="font-mono">@Model.CargoTrackingNumber</span>
                    </p>
                </div>
            }

            <form asp-controller="Order" asp-action="Ship" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Kargo Firması</label>
                    <input name="cargoCompany" value="@Model.CargoCompany"
                           placeholder="Örn. Yurtiçi Kargo, Aras Kargo…"
                           class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-pink-400 focus:ring-2 focus:ring-pink-100 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Kargo Takip Numarası</label>
                    <input name="cargoTrackingNumber" value="@Model.CargoTrackingNumber"
                           placeholder="Kargo firmasının verdiği takip no"
                           class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm font-mono focus:border-pink-400 focus:ring-2 focus:ring-pink-100 outline-none" />
                </div>

                <button type="submit"
                        onclick="return confirm('Sipariş kargoya verilecek ve müşteriye bilgilendirme maili gönderilecek. Onaylıyor musunuz?');"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-gradient-to-r from-pink-500 to-rose-600 text-white text-sm font-semibold hover:opacity-90 transition-opacity">
                    📧 Kargoya Ver ve Bildir
                </button>
                <p class="text-xs text-gray-400 text-center">
                    Durum otomatik olarak "Kargoda" yapılır ve
                    @(!string.IsNullOrWhiteSpace(Model.CustomerEmail) ? Model.CustomerEmail : "müşteri e-postası")
                    adresine mail gider.
                </p>
            </form>
        </div>

        <!-- Durum Güncelle -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                🔖 Sipariş Durumunu Güncelle
            </h2>
            <form asp-controller="Order" asp-action="UpdateStatus" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Durum</label>
                    @{
                        var statuses = new[] { "Onay Bekliyor", "Beklemede", "Onaylandı", "Kargoda", "Teslim Edildi", "İptal Edildi" };
                    }
                    <select name="orderStatus"
                            class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-pink-400 focus:ring-2 focus:ring-pink-100 outline-none">
                        @foreach (var s in statuses)
                        {
                            if (s == Model.OrderStatus)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-semibold hover:bg-gray-700 transition-colors">
                    Durumu Kaydet
                </button>
                <p class="text-xs text-gray-400 text-center">
                    Bu işlem müşteriye mail göndermez, yalnızca durumu değiştirir.
                </p>
            </form>
        </div>
    </div>

</div>