<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Ankavera Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Montserrat:wght@300;400;500;600&display=swap"
          rel="stylesheet" />

    <style>
        body {
        font-family: 'Montserrat', sans-serif;
        }

        .font-serif {
        font-family: 'Cormorant Garamond', Georgia, serif;
        }

        /* Sidebar link aktif */
        .sidebar-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        border-radius: 0.75rem;
        font-size: 0.8rem;
        font-weight: 400;
        color: #9d7a8a;
        letter-spacing: 0.02em;
        transition: all 0.2s;
        text-decoration: none;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
        background: linear-gradient(135deg, #fce7f3, #fdf2f8);
        color: #be185d;
        }

        .sidebar-link.active {
        font-weight: 500;
        box-shadow: inset 3px 0 0 #e11d48;
        }

        /* Sidebar scroll */
        #admin-sidebar {
        transition: transform 0.3s ease;
        }

        @@media (max-width: 1024px) {
        #admin-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: 50;
        transform: translateX(-100%);
        }

        #admin-sidebar.open {
        transform: translateX(0);
        }
        }
    </style>
</head>

<body class="bg-rose-50/40 min-h-screen">

    <div class="flex min-h-screen">

        <!-- ══════════════════════════════════
             SIDEBAR
        ══════════════════════════════════ -->
        <aside id="admin-sidebar"
               class="w-64 bg-white border-r border-rose-100/60 flex flex-col"
               style="min-height: 100vh;">

            <!-- Logo -->
            <div class="px-5 py-6 border-b border-rose-50">
                <div class="flex items-center gap-3">
                    <img src="/images/WhatsApp Image 2026-06-21 at 21.07.51.jpeg"
                         alt="Ankavera"
                         class="h-10 w-auto object-contain rounded-lg"
                         onerror="this.style.display='none';" />
                    <div class="leading-tight">
                        <p class="font-serif text-lg font-light text-rose-800 tracking-wider">
                            Ankavera
                        </p>
                        <p class="text-xs text-rose-400 font-light tracking-widest uppercase">
                            Admin Panel
                        </p>
                    </div>
                </div>
            </div>

            <!-- Nav -->
            <nav class="flex-1 px-3 py-5 space-y-1">

                <p class="px-3 pt-2 pb-1 text-xs font-medium text-rose-300
                tracking-widest uppercase">Genel</p>

                <a asp-action="Index" asp-controller="Admin"
                   class="sidebar-link @(ViewData["Title"]?.ToString() == "Admin Paneli" ? "active" : "")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                         stroke-width="1.8" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                    Dashboard
                </a>

                <a asp-action="Users" asp-controller="Admin"
                   class="sidebar-link @(ViewData["Title"]?.ToString() == "Kullanıcı Yönetimi" ? "active" : "")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                         stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Kullanıcılar
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-medium text-rose-300
                tracking-widest uppercase">Mağaza</p>

                <a href="#"
                   class="sidebar-link opacity-50 cursor-not-allowed"
                   title="Yakında">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                         stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    Ürünler
                    <span class="ml-auto text-xs bg-rose-100 text-rose-400
                    px-2 py-0.5 rounded-full">Yakında</span>
                </a>

                <a href="#"
                   class="sidebar-link opacity-50 cursor-not-allowed"
                   title="Yakında">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                         stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" ry="1" />
                    </svg>
                    Siparişler
                    <span class="ml-auto text-xs bg-rose-100 text-rose-400
                    px-2 py-0.5 rounded-full">Yakında</span>
                </a>

            </nav>

            <!-- Alt: Siteye Dön + Çıkış -->
            <div class="px-3 py-5 border-t border-rose-50 space-y-1">
                <a href="/" class="sidebar-link">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                         stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Siteye Dön
                </a>

                <form asp-action="Logout" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link w-full text-left
                        hover:bg-red-50 hover:text-red-500">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Çıkış Yap
                    </button>
                </form>
            </div>
        </aside>

        <!-- ══════════════════════════════════
             ANA İÇERİK
        ══════════════════════════════════ -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <header class="bg-white border-b border-rose-100/60 px-6 py-4
                flex items-center justify-between sticky top-0 z-40">

                <!-- Sol: Hamburger (mobil) + Başlık -->
                <div class="flex items-center gap-4">
                    <button id="sidebar-toggle"
                            class="lg:hidden p-2 rounded-lg hover:bg-rose-50 transition-colors">
                        <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="12" x2="21" y2="12" />
                            <line x1="3" y1="18" x2="21" y2="18" />
                        </svg>
                    </button>

                    <div>
                        <h1 class="font-serif text-xl font-light text-rose-900">
                            @ViewData["Title"]
                        </h1>
                        <p class="text-xs text-rose-400 font-light hidden sm:block">
                            @DateTime.Now.ToString("dd MMMM yyyy, dddd")
                        </p>
                    </div>
                </div>

                <!-- Sağ: Admin bilgisi -->
                <div class="flex items-center gap-3">
                    <div class="text-right hidden sm:block">
                        <p class="text-xs font-medium text-rose-800">@User.Identity?.Name</p>
                        <p class="text-xs text-rose-400 font-light">Yönetici</p>
                    </div>
                    <div class="w-9 h-9 rounded-full flex items-center justify-center
                        text-white text-sm font-semibold"
                         style="background: linear-gradient(135deg,#fb923c,#e11d48);">
                        👑
                    </div>
                </div>
            </header>

            <!-- Sayfa İçeriği -->
            <main class="flex-1 p-6 lg:p-8">

                <!-- Başarı TempData (global) -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-6 bg-green-50 border border-green-200 border-l-4
                        border-l-green-500 rounded-xl px-5 py-4">
                        <p class="text-green-700 text-sm font-light">
                            ✓ @TempData["SuccessMessage"]
                        </p>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Mobil Sidebar Overlay -->
    <div id="sidebar-overlay"
         class="fixed inset-0 bg-black/30 z-40 hidden lg:hidden"
         onclick="closeSidebar()">
    </div>

    <script>
        const sidebar         = document.getElementById('admin-sidebar');
        const sidebarOverlay  = document.getElementById('sidebar-overlay');
        const sidebarToggle   = document.getElementById('sidebar-toggle');

        sidebarToggle?.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        sidebarOverlay.classList.toggle('hidden');
        });

        function closeSidebar() {
        sidebar.classList.remove('open');
        sidebarOverlay.classList.add('hidden');
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>